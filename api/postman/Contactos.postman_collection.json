{
  "info": {
    "name": "API de Contactos con firma digital (Tarea 2P · Grupo 2)",
    "description": "Pruebas de la API. Antes de ejecutar: Settings → General → Working directory = esta carpeta (api/postman), para que Postman encuentre firma_ejemplo.png, no_es_png.jpg y firma_grande.png. Ejecutar en orden (Run collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "idContacto", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Crear contacto con firma PNG (201)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
        "const j = pm.response.json();",
        "pm.test('Guarda solo los metadatos del archivo', () => { pm.expect(j.archivoMime).to.eql('image/png'); pm.expect(j.archivoTamano).to.be.above(0); });",
        "pm.collectionVariables.set('idContacto', j.id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "formdata", "formdata": [
          { "key": "nombre", "value": "Jose de Jesus Sarmiento", "type": "text" },
          { "key": "telefono", "value": "99765645", "type": "text" },
          { "key": "latitud", "value": "14.48", "type": "text" },
          { "key": "longitud", "value": "-88.78", "type": "text" },
          { "key": "archivo", "type": "file", "src": "firma_ejemplo.png" }
        ]},
        "url": { "raw": "{{baseUrl}}/api/contactos", "host": ["{{baseUrl}}"], "path": ["api", "contactos"] }
      }
    },
    {
      "name": "2. Crear sin firma ni teléfono (400)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 400', () => pm.response.to.have.status(400));",
        "pm.test('Trae mensaje JSON para la app', () => { const j = pm.response.json(); pm.expect(j.detail).to.be.a('string'); pm.expect(j.errors).to.have.property('archivo'); });"
      ]}}],
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "formdata", "formdata": [
          { "key": "nombre", "value": "Maria Lopez", "type": "text" },
          { "key": "latitud", "value": "15.5", "type": "text" },
          { "key": "longitud", "value": "-88.0", "type": "text" }
        ]},
        "url": { "raw": "{{baseUrl}}/api/contactos", "host": ["{{baseUrl}}"], "path": ["api", "contactos"] }
      }
    },
    {
      "name": "3. Crear con archivo JPG (415)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 415 Unsupported Media Type', () => pm.response.to.have.status(415));",
        "pm.test('Explica que solo se acepta PNG', () => pm.expect(pm.response.json().detail).to.include('image/png'));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "formdata", "formdata": [
          { "key": "nombre", "value": "Maria Lopez", "type": "text" },
          { "key": "telefono", "value": "95117652", "type": "text" },
          { "key": "latitud", "value": "15.5", "type": "text" },
          { "key": "longitud", "value": "-88.0", "type": "text" },
          { "key": "archivo", "type": "file", "src": "no_es_png.jpg" }
        ]},
        "url": { "raw": "{{baseUrl}}/api/contactos", "host": ["{{baseUrl}}"], "path": ["api", "contactos"] }
      }
    },
    {
      "name": "4. Crear con firma mayor a 1 MB (400)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 400', () => pm.response.to.have.status(400));",
        "pm.test('Menciona el máximo de 1 MB', () => pm.expect(pm.response.json().detail).to.include('1 MB'));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "formdata", "formdata": [
          { "key": "nombre", "value": "Maria Lopez", "type": "text" },
          { "key": "telefono", "value": "95117652", "type": "text" },
          { "key": "latitud", "value": "15.5", "type": "text" },
          { "key": "longitud", "value": "-88.0", "type": "text" },
          { "key": "archivo", "type": "file", "src": "firma_grande.png" }
        ]},
        "url": { "raw": "{{baseUrl}}/api/contactos", "host": ["{{baseUrl}}"], "path": ["api", "contactos"] }
      }
    },
    {
      "name": "5. Listar contactos (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 200 con un arreglo', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
      ]}}],
      "request": { "method": "GET", "header": [],
        "url": { "raw": "{{baseUrl}}/api/contactos", "host": ["{{baseUrl}}"], "path": ["api", "contactos"] } }
    },
    {
      "name": "6. Buscar por nombre (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Todos los resultados contienen el texto buscado', () => pm.response.json().forEach(c => pm.expect(c.nombre.toLowerCase()).to.include('jose')));"
      ]}}],
      "request": { "method": "GET", "header": [],
        "url": { "raw": "{{baseUrl}}/api/contactos?buscar=jose", "host": ["{{baseUrl}}"], "path": ["api", "contactos"],
          "query": [{ "key": "buscar", "value": "jose" }] } }
    },
    {
      "name": "7. Descargar firma (200 image/png)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 200', () => pm.response.to.have.status(200));",
        "pm.test('Content-Type correcto', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png'));"
      ]}}],
      "request": { "method": "GET", "header": [],
        "url": { "raw": "{{baseUrl}}/api/contactos/{{idContacto}}/archivo", "host": ["{{baseUrl}}"], "path": ["api", "contactos", "{{idContacto}}", "archivo"] } }
    },
    {
      "name": "8. Actualizar contacto (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 200 con el nombre nuevo', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().nombre).to.eql('Jose Escalante'); });"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Jose Escalante\",\n  \"telefono\": \"99765645\",\n  \"latitud\": 15.50,\n  \"longitud\": -88.00\n}" },
        "url": { "raw": "{{baseUrl}}/api/contactos/{{idContacto}}", "host": ["{{baseUrl}}"], "path": ["api", "contactos", "{{idContacto}}"] }
      }
    },
    {
      "name": "9. Actualizar con datos inválidos (400)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 400 con errores por campo', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors).to.have.property('telefono'); });"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"\",\n  \"telefono\": \"123\",\n  \"latitud\": 200,\n  \"longitud\": -88.00\n}" },
        "url": { "raw": "{{baseUrl}}/api/contactos/{{idContacto}}", "host": ["{{baseUrl}}"], "path": ["api", "contactos", "{{idContacto}}"] }
      }
    },
    {
      "name": "10. Eliminar contacto (204)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 204 No Content', () => pm.response.to.have.status(204));"
      ]}}],
      "request": { "method": "DELETE", "header": [],
        "url": { "raw": "{{baseUrl}}/api/contactos/{{idContacto}}", "host": ["{{baseUrl}}"], "path": ["api", "contactos", "{{idContacto}}"] } }
    },
    {
      "name": "11. Descargar firma de contacto eliminado (404)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 404', () => pm.response.to.have.status(404));"
      ]}}],
      "request": { "method": "GET", "header": [],
        "url": { "raw": "{{baseUrl}}/api/contactos/{{idContacto}}/archivo", "host": ["{{baseUrl}}"], "path": ["api", "contactos", "{{idContacto}}", "archivo"] } }
    }
  ]
}
