<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Genera el XML de comentarios para que Swagger muestre las descripciones -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contactos.Application\Contactos.Application.csproj" />
    <ProjectReference Include="..\Contactos.Infrastructure\Contactos.Infrastructure.csproj" />
  </ItemGroup>

  <!-- La base de datos y las firmas son datos locales, no se publican -->
  <ItemGroup>
    <Content Remove="almacen\**" />
    <None Remove="contactos.db*" />
  </ItemGroup>

</Project>
